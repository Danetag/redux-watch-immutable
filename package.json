{
  "name": "redux-watch-immutable",
  "description": "Watch Immutable.js values in a Redux store",
  "version": "1.0.0",
  "private": false,
  "author": "Arnaud Tanielian, Abhaya Rawal",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danetag/redux-watch-immutable.git"
  },
  "bugs": {
    "url": "https://github.com/danetag/redux-watch-immutable/issues"
  },
  "homepage": "https://github.com/danetag/redux-watch-immutable#readme",
  "license": "MIT",
  "keywords": [
    "immutable",
    "redux",
    "watcher",
    "observer"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "immutable": "^4.0.0 || ^5.0.0",
    "redux": ">=3.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "immutable": "^5.1.3",
    "redux": "^5.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
